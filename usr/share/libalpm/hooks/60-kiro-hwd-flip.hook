# Keep the NVIDIA 620 flip-timeout option in step with the installed nvidia-utils (NVIDIA bug 7126445).
# Version-based, no hardware detection, so it is also right in the ISO build chroot. Runs before
# 90-mkinitcpio-install.hook; kiro-hwd rebuilds the initramfs itself when nvidia is in it.
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = nvidia-utils

[Action]
Description = kiro-hwd: NVIDIA 620 flip-timeout option...
When = PostTransaction
Exec = /usr/bin/kiro-hwd flip-fix
